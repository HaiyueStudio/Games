{
  "format": "haiyue-valley-map",
  "version": 1,
  "catalogVersion": 1,
  "id": "logic-garden",
  "name": "双灯之约 · 事件、条件与动作",
  "logic": {
    "variables": [
      {
        "id": "progress",
        "name": "点灯进度",
        "initial": 0
      },
      {
        "id": "visits",
        "name": "穿门次数",
        "initial": 0
      }
    ],
    "rules": [
      {
        "id": "welcome",
        "name": "旅行者的约定",
        "enabled": true,
        "once": true,
        "event": {
          "type": "start",
          "source": null
        },
        "condition": {
          "kind": "all",
          "conditions": []
        },
        "actions": [
          {
            "kind": "message",
            "text": "先点亮第一盏灯，再点亮第二盏灯，门才会回应。"
          }
        ]
      },
      {
        "id": "first-light",
        "name": "记录第一盏灯",
        "enabled": true,
        "once": true,
        "event": {
          "type": "switch",
          "source": "first"
        },
        "condition": {
          "kind": "variable",
          "id": "progress",
          "op": "eq",
          "value": 0
        },
        "actions": [
          {
            "kind": "variable",
            "id": "progress",
            "operation": "set",
            "value": 1
          },
          {
            "kind": "message",
            "text": "第一盏灯已亮。继续向右，点亮第二盏灯。"
          }
        ]
      },
      {
        "id": "second-light",
        "name": "两盏灯共同回应",
        "enabled": true,
        "once": true,
        "event": {
          "type": "switch",
          "source": "second"
        },
        "condition": {
          "kind": "all",
          "conditions": [
            {
              "kind": "variable",
              "id": "progress",
              "op": "eq",
              "value": 1
            },
            {
              "kind": "switch",
              "objectId": "first",
              "value": true
            },
            {
              "kind": "switch",
              "objectId": "second",
              "value": true
            }
          ]
        },
        "actions": [
          {
            "kind": "variable",
            "id": "progress",
            "operation": "set",
            "value": 2
          }
        ]
      },
      {
        "id": "open-gate",
        "name": "升起花灯，展开机关",
        "enabled": true,
        "once": true,
        "event": {
          "type": "variable",
          "source": "progress"
        },
        "condition": {
          "kind": "variable",
          "id": "progress",
          "op": "eq",
          "value": 2
        },
        "actions": [
          {
            "kind": "message",
            "text": "两盏灯相互回应，远处的门正在苏醒。"
          },
          {
            "kind": "wait",
            "duration": 0.3
          },
          {
            "kind": "parallel",
            "actions": [
              {
                "kind": "move",
                "groupId": "lanterns",
                "translation": [
                  0,
                  1,
                  0
                ],
                "rotation": [
                  0,
                  90,
                  0
                ],
                "duration": 0.8,
                "easing": "smooth"
              },
              {
                "kind": "wait",
                "duration": 0.6
              }
            ]
          },
          {
            "kind": "state",
            "targetId": "gate-a",
            "property": "enabled",
            "value": true
          },
          {
            "kind": "state",
            "targetId": "wheel",
            "property": "enabled",
            "value": true
          },
          {
            "kind": "message",
            "text": "门已开启。穿过光幕，前往另一座岛。"
          }
        ]
      },
      {
        "id": "arrived",
        "name": "抵达彼岸",
        "enabled": true,
        "once": false,
        "event": {
          "type": "portal",
          "source": "gate-a"
        },
        "condition": {
          "kind": "all",
          "conditions": []
        },
        "actions": [
          {
            "kind": "variable",
            "id": "visits",
            "operation": "add",
            "value": 1
          },
          {
            "kind": "state",
            "targetId": "exit",
            "property": "enabled",
            "value": true
          },
          {
            "kind": "message",
            "text": "约定已经完成。沿着道路走向出口。"
          }
        ]
      }
    ]
  },
