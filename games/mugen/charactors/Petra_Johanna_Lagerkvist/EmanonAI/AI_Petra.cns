;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;AI起動用ヘルパー
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;---------------------------------------------------------------------------

[Statedef 90000]
anim=0;なにも表示しないｱﾆﾒでもいいけど入れなくても全然問題ない
ctrl=0

[State 10000,間違いで本体が来たら立ちへ移行]
type=selfstate
trigger1=!ishelper(90000)
value=0

[State 10000,プレイヤー判定]
type=parentvarset
Trigger1=command="a"&&root,command="a"
Trigger2=command="b"&&root,command="b"
Trigger3=command="c"&&root,command="c"
Trigger4=command="x"&&root,command="x"
Trigger5=command="y"&&root,command="y"
Trigger6=command="z"&&root,command="z"
Trigger7=command="start"&&root,command="start"
Trigger8=command="fwd"&&root,command="fwd"
Trigger9=command="back"&&root,command="back"
Trigger10=command="up"&&root,command="up"
Trigger11=command="down"&&root,command="down"
var(54)=-1

[State 10000,立ったら消失]
Type = DestroySelf
TriggerAll=isHelper
Trigger1=root,var(53)!=0||var(54)=-1
Trigger2=command="a"&&root,command="a"
Trigger3=command="b"&&root,command="b"
Trigger4=command="c"&&root,command="c"
Trigger5=command="x"&&root,command="x"
Trigger6=command="y"&&root,command="y"
Trigger7=command="z"&&root,command="z"
Trigger8=command="start"&&root,command="start"
Trigger9=command="fwd"&&root,command="fwd"
Trigger10=command="back"&&root,command="back"
Trigger11=command="up"&&root,command="up"
Trigger12=command="down"&&root,command="down"
Trigger13 = root,var(54) = -1

[State 10000,AIﾌﾗｸﾞON]
Type=varset
TriggerAll=var(53)!=-1
TriggerAll = root,var(54) != -1
Trigger1=root,command="a"
Trigger2=root,command="b"
Trigger3=root,command="c"
Trigger4=root,command="x"
Trigger5=root,command="y"
Trigger6=root,command="z"
Trigger7=root,command="start"
Trigger8=root,command="fwd"&&(roundstate=2&&root,ctrl)
Trigger9=root,command="back"&&(roundstate=2&&root,ctrl)
Trigger10=root,command="up"&&(roundstate=2&&root,ctrl)
Trigger11=root,command="down"&&(roundstate=2&&root,ctrl)
var(53)=1

;-------------------------------------------------------------------------------------
[Statedef -3]

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;[AI記述]
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;-------------------------------------------------------------------------------------

;------------------------------------
;＊ＡＩ用ヘルパー
[State -3, AI起動用ヘルパー]
type=helper
TriggerAll = !IsHelper
TriggerAll = RoundState<2 || (RoundState=2&&ctrl)
trigger1 = NumHelper(90000) = 0
trigger1 = alive
trigger1 = var(53) = 0
Trigger1 = var(54) != -1
helpertype=normal
name="AI"
stateno=90000
ID=90000
pos=9999,9999
keyctrl=1
pausemovetime=2147483647
supermovetime=2147483647
persistent = 0

;念のため↓も付けておく
[State -3, 関係無いステートに行かないように]
type=changestate
trigger1= ishelper(90000)
trigger1= stateno!=90000
value=90000

;------------------------------------
;＊補助ヘルパー起動
[State -3,補助ヘルパー起動]
type = Helper
TriggerAll = !IsHelper
Trigger1 = NumHelper(90001) = 0
HelperType = Normal
Name = "Emanon"
StateNo = 90001
ID = 90001
pos = 0,0
postype = p1
supermovetime = 999999999
pausermovetime = 999999999

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ＡＩ起動
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;---------------------------------------------------------------------------
[State -3, AIフラグセット]
type = VarSet
TriggerAll = Var(53) = 0
TriggerAll = RoundState = [1,2]
trigger1 = Command = "AI0" || Command = "AI1" || Command = "AI2"
trigger2 = Command = "AI3" || Command = "AI4" || Command = "AI6"
trigger3 = Command = "AI7" || Command = "AI8" || Command = "AI9"
trigger4 = Command = "AI10" || Command = "AI11" || Command = "AI12"
trigger5 = Command = "AI13" || Command = "AI14" || Command = "AI15"
trigger6 = Command = "AI16" || Command = "AI17" || Command = "AI18"
trigger7 = Command = "AI19" || Command = "AI20" || Command = "AI21"
trigger8 = Command = "AI22" || Command = "AI23" || Command = "AI24"
trigger9 = Command = "AI25" || Command = "AI26" || Command = "AI27"
trigger10 = Command = "AI28" || Command = "AI29" || Command = "AI30"
trigger11 = Command = "AI31" || Command = "AI32" || Command = "AI33"
trigger12 = Command = "AI34" || Command = "AI35" || Command = "AI36"
trigger13 = Command = "AI37" || Command = "AI38" || Command = "AI39"
trigger14 = Command = "AI40"
Trigger15 = Var(53) = 0
Trigger15 = NumHelper(90000)
Trigger15 = Helper(90000),Var(53)>0
;Trigger16 = 1; Trigger16の左のセミコロンを外すことで、AIを常時起動にする事が可能です
var(53) = 1
IgNoreHitPause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;※※※　設定可能項目　※※※
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;----------------------------------------------------------------
[State -3,AIレベル]
type = varset
Trigger1 = var(53) = 1
v = 54
value = 5
IgNoreHitPause = 1

;valueの値を変更することで、AIレベルを設定可能(Default:5)
;＊Lv1～3:対人？
;＊Lv4～6:対ＡＩ　特にLv6は超反応多し

;----------------------------------------------------------------
[State -3,アルカナセレクト]
type = varset
Trigger1 = var(53) = 1
v = 58
value = 1
IgNoreHitPause = 1
;＊valueの値を変更する事で、AI起動時のアルカナを選択可能
;Default:1(愛アレンジ)

;現在『愛』『雷』に対応済み
;対応していないアルカナでも一応戦えますが、アルカナ技を一切使用しませんのでご注意

;※以下のリストは「色々メモ.txt」からコピペ
;(0=無し、1-12=アレンジ仕様、13-24=アルカナ仕様、25-36=フル仕様)

;----------------------------------------------------------------
[State -3,モードセレクト]
type = varset
Trigger1 = var(53) = 1
v = 59
value = 4
IgNoreHitPause = 1
;＊valueの値を変更する事で、AI起動時の本体のモードを選択可能
;Default:4(アルカナ２アレンジ)

;アルカナ１関係のモード(1～3)は動きに不具合が出る可能性があるので、
;できれば２関係のモード(4～6)を使用してください

;※以下のリストは「色々メモ.txt」からコピペ
;(0=未設定、1=アルカナアレンジ、2=アルカナ、3=ハートフル、4=アルカナ2アレンジ、5=アルカナ2、6=すごカナ)

;----------------------------------------------------------------
[State -3,勝ち挑発スイッチ]
type = varset
Trigger1 = RoundState != 3
v = 51
value= 1
IgNoreHitPause = 1
;＊↑のvalueの値を変更することで勝ち挑発(L.G.A.charge-1)の制御が可能
;勝ち挑発はAIレベル5以上で使用します
;0:off
;1:on(Default)

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;※※※　設定可能項目ここまで　※※※
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;↓は弄らないでください

[State -3,勝ち挑発使用確認]
type = varset
Trigger1 = RoundState = 3
Trigger1 = StateNo = 400
v = 51
value= 2
IgNoreHitPause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;優先度高め
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

;---------------------------------------------------------------------------
;・勝ち挑発
[State -3,L.G.A.charge-1]
type = ChangeState
value = 400
TriggerAll = (var(53) = 1) && (var(54) > 0)
TriggerAll = var(54) >= 5;AIレベル5以上
triggerall = var(51) = 1;勝ち挑発スイッチ
TriggerAll = Alive
TriggerAll = RoundState = 3
TriggerAll = Win && (!WinTime)
trigger1 = (statetype != A && ctrl) || (StateNo = 19) || (StateNo = 0)
Ctrl = 1

;Trigger1 = TeamMode = Simul
;Trigger1 = (Enemy(0),StateType != A) && (Enemy(1),StateType != A)
;Trigger2 = (TeamMode = Single) || (TeamMode = Turns)
;Trigger2 = NumHelper(90001) && (Helper(90001),var(56) = [1,2])

;---------------------------------------------------------------------------
;バックステップ・投げと攻撃回避
[State -3]
type = ChangeState
value = 105
TriggerAll = (var(53) = 1) && (var(54) > 0)
TriggerAll = fvar(36) = 0
TriggerAll = (RoundState = 2) && (Alive)
TriggerAll = NumHelper(90001) && (Helper(90001),var(56) = [1,3])
triggerall = StateNo != [100,109]
triggerAll = ((statetype = S) && (ctrl = 1)) || (StateNo = 19)
TriggerAll = Random < (35 * Var(54))
Trigger1 = (Enemynear(var(52)),Time >= 7) || (!Time&&(var(54) = [4,5])) || (var(54) = 6)
Trigger1 = InGuardDist && P2BodyDist X = [45,75]
Trigger1 = BackEdgeBodyDist > 50
Trigger2 = EnemyNear(var(57)),HitDefAttr = SCA,NT,ST,HT ;投げ属性

;-------------------------------------------------------------
;・パルちゃん
;イリオススフェラ発動
[State -3,イリオススフェラ発動]
type = ChangeState
value = 1080
TriggerAll = (var(53) = 1) && (var(54) > 0)
TriggerAll = fvar(36) = 1
TriggerAll = (RoundState = 2) && (Alive)
triggerall = ((statetype != A) && Ctrl) || StateNo = 19
triggerall = var(58) = 1 || var(58) = 13 || var(58) = 25
triggerall = var(46) = 1
TriggerAll = NumHelper(90001) && (Helper(90001),var(56) = 3)
TriggerAll = (Enemynear(var(52)),Time >= (19 - var(54))) || (!Time&&(var(54) = [4,5])) || (var(54) = 6)
TriggerAll = Time > Ceil(12 - var(54) * 2.1)
Trigger1 = Random < var(54) * ((var(54) = [1,2]) * 1 + (var(54) = [3,4]) * 30 + (var(54) = [5,6]) * 90)

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ホーミング停止条件
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

;---------------------------------------------------------------------------
;地上レバーホーミング停止条件・ＡＩ・吹き飛ばし関係から
[State -3,地上レバーホーミング停止・ＣＨ狙い]
type = changestate
value = 364
TriggerAll = (var(53) = 1) && (var(54) > 0)
TriggerAll = (RoundState = 2) && (Alive)
TriggerAll = Time >= 5
TriggerAll = StateNo = 363
Trigger1 = fvar(36) = [12,13];吹き飛ばし・ＣＨ狙い
Trigger1 = Random < var(54) * 350
Ctrl = 1

;---------------------------------------------------------------------------
;地上レバーホーミング停止条件・ＡＩ・吹き飛ばし関係から
[State -3,地上レバーホーミング停止・吹き飛ばし]
type = changestate
value = 364
TriggerAll = (var(53) = 1) && (var(54) > 0)
TriggerAll = (RoundState = 2) && (Alive)
TriggerAll = Time >= 5
TriggerAll = fvar(36) = 14;通常ホーミング追撃
TriggerAll = StateNo = 363
TriggerAll = Random < var(54) * 350
;Trigger1 = (FrontEdgeBodyDist < 55) && (Enemynear(var(52)),BackEdgeBodyDist < 35)
;Trigger1 = Enemynear(var(52)),BackEdgeBodyDist < 55
Trigger1 = FrontEdgeBodyDist < 45
;Trigger1 = P2BodyDist X = [-5,20]
Trigger1 = Ceil((P2BodyDist X) + fvar(31) * 3) = [-30,40]
Trigger1 = fvar(36) := 15
Trigger2 = !((P2StateNo = [293,296]) || (P2StateNo = 298));相手ワイヤー以外
Trigger2 = fvar(36) := 15
Ctrl = 1

;---------------------------------------------------------------------------
;地上レバーホーミング停止条件・ＡＩ・通常停止
[State -3,地上レバーホーミング停止・通常停止]
type = changestate
value = 364
TriggerAll = (var(53) = 1) && (var(54) > 0)
TriggerAll = (Alive)
TriggerAll = Time >= 5
TriggerAll = StateNo = 363
;Trigger1 = fvar(36) != 14
Trigger1 = P2Dist X <= 0;裏回ったら停止
Trigger1 = Random < var(54) * 440
Trigger2 = fvar(36) = 100;通常ダッシュ
Trigger2 = InGuardDist || (NumHelper(90001) && (Helper(90001),var(51) = 1))
Trigger2 = Random < var(54) * 190
Trigger3 = fvar(36) = 100;通常ダッシュ
Trigger3 = P2BodyDist X = [-30,40];５Ａ射程範囲
;Trigger3 = Ceil((P2BodyDist X) + fvar(31) * 3) = [-30,25]
Trigger3 = Random < var(54) * 195
Trigger4 = RoundState != 2
Ctrl = 1

;-------------------------------------------------------------
;ホーミング停止・追撃時
[State -3,ホーミング停止・追撃時]
type = ChangeState
value = 352
TriggerAll = (var(53) = 1) && (var(54) > 0)
TriggerAll = Alive
TriggerAll = fvar(36) = 2
TriggerAll = StateNo = 351
Trigger1 = Ceil((P2BodyDist X) + fvar(31) * 7) = [-5,75]
Trigger1 = Ceil((P2BodyDist Y) + fvar(32) * 7) = [-95,-15]
Trigger1 = Random < var(54) * 330
Ctrl = 1

;-------------------------------------------------------------
;ガーキャンホーミング停止
[state 800,ガーキャンホーミング停止]
type = changestate
value = 364
TriggerAll = (var(53) = 1) && (var(54) > 0)
TriggerAll = Alive
triggerAll = time >= 5
TriggerAll = (StateNo = 383) || (StateNo = 391)
Trigger1 = P2Dist X < 0;裏回った時
Trigger1 = Random < var(54) * 340
Trigger2 = P2BodyDist X = [0,30]
Trigger2 = Enemynear(var(52)),MoveType != A
;Trigger2 = !InGuardDist
Trigger2 = Random < var(54) * 240

