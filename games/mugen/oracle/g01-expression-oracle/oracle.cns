[Statedef -2]

[State -2, reset result]
type = VarSet
triggerall = RoundState = 2
trigger1 = Time = 0
v = 59
value = 0

[State -2, reset short circuit]
type = VarRangeSet
triggerall = RoundState = 2
trigger1 = Time = 0
first = 10
last = 13
value = 0

[State -2, precedence]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = 3+2*5 = 13
v = 59
value = 1

[State -2, typed left order]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = 5.0*5/6 = 4.1666665
v = 59
value = 1

[State -2, typed right order]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = 5/6*5.0 = 0.0
v = 59
value = 1

[State -2, unary]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = -!0 = -1
v = 59
value = 1

[State -2, integer division]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = 7/2 = 3
v = 59
value = 1

[State -2, zero power zero]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = 0**0 = 1
v = 59
value = 1

[State -2, power saturation]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = 2**31 = 2147483647
v = 59
value = 1

[State -2, bitwise]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = (~0 & 255) = 255
v = 59
value = 1

[State -2, logical xor]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = (0 ^^ 4) = 1
v = 59
value = 1

[State -2, closed interval]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = 2 = [0,2]
v = 59
value = 1

[State -2, half open interval]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = 2 != [0,2)
v = 59
value = 1

[State -2, floor]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = Floor(5.5) = 5
v = 59
value = 1

[State -2, ceil]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = Ceil(-2.5) = -2
v = 59
value = 1

[State -2, assignment]
type = Null
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = (var(10) := 7.9) = 7

[State -2, assignment result]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = var(10) = 7
v = 59
value = 1

[State -2, logical short circuit side effect]
type = Null
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = 0 && (var(11) := 1)

[State -2, logical short circuit result]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = var(11) = 0
v = 59
value = 1

[State -2, IfElse eager side effect]
type = Null
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = IfElse(0,var(12):=1,0)

[State -2, IfElse eager result]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = var(12) = 1
v = 59
value = 1

[State -2, Cond lazy side effect]
type = Null
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = Cond(0,var(13):=1,0)

[State -2, Cond lazy result]
type = VarAdd
triggerall = RoundState = 2
trigger1 = Time = 0
trigger1 = var(13) = 0
v = 59
value = 1

[State -2, fail marker]
type = ChangeState
triggerall = RoundState = 2
trigger1 = Time >= 60
trigger1 = var(59) != 17
value = 999999

[State -2, pass marker]
type = DisplayToClipboard
triggerall = RoundState = 2
trigger1 = Time >= 0
text = "HAIYUE_G01_ORACLE count=%d"
params = var(59)
