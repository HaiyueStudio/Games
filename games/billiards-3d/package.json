{
  "name": "@haiyue/game-billiards-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/workspace-task.mjs build billiards-3d",
    "test": "node ../../scripts/workspace-task.mjs test billiards-3d",
    "typecheck": "node ../../scripts/workspace-task.mjs typecheck billiards-3d"
  },
  "dependencies": {
    "@haiyue/games-platform": "0.1.0"
  },
  "peerDependencies": {
    "@haiyue/animation-spec": "*",
    "@haiyue/engine": "*",
    "@haiyue/engine-gamepad": "*",
    "@haiyue/extensions": "*",
    "@haiyue/extensions-controls": "*",
    "@haiyue/ui": "*",
    "wgpu-matrix": "*"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/bundle.js",
          "{projectRoot}/bundle.js.map"
        ]
      },
      "test": {
        "inputs": [
          "production",
          "^production",
          "testGlobals",
          "{workspaceRoot}/games/test/billiards-3d-audio.test.mjs",
          "{workspaceRoot}/games/test/billiards-3d-input.test.mjs",
          "{workspaceRoot}/games/test/billiards-3d-rendering.test.mjs"
        ]
      }
    }
  }
}
