{
  "name": "@haiyue/game-neon-circuit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/workspace-task.mjs build neon-circuit",
    "test": "node ../../scripts/workspace-task.mjs test neon-circuit",
    "typecheck": "node ../../scripts/workspace-task.mjs typecheck neon-circuit"
  },
  "dependencies": {
    "@haiyue/games-platform": "0.1.0"
  },
  "peerDependencies": {
    "@haiyue/animation-spec": "*",
    "@haiyue/engine": "*",
    "@haiyue/engine-gamepad": "*",
    "@haiyue/extensions": "*",
    "@haiyue/extensions-controls": "*",
    "@haiyue/ui": "*",
    "wgpu-matrix": "*"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/bundle.js",
          "{projectRoot}/bundle.js.map"
        ]
      },
      "test": {
        "inputs": [
          "production",
          "^production",
          "testGlobals",
          "{workspaceRoot}/games/test/neon-circuit-audio.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-carousel.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-coaster.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-effects.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-glass.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-locale.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-map.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-mobius.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-opponent.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-raster.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-rules.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-surface.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-texture-batch.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-verifier.test.mjs",
          "{workspaceRoot}/games/test/neon-circuit-volcanic.test.mjs"
        ]
      }
    }
  }
}
