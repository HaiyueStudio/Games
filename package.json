{
  "name": "@haiyue/games-repository",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/HaiyueStudio/Games.git",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deps:local": "node scripts/install-local-dependencies.mjs",
    "build": "node scripts/build-games.mjs",
    "build:target": "node scripts/build-target.mjs",
    "preview:build": "node scripts/build-preview-site.mjs",
    "editor:valley": "npm --prefix tools/valley-editor run serve",
    "build:valley-editor": "npm --prefix tools/valley-editor run build",
    "dev": "node scripts/dev-games.mjs",
    "lint": "eslint games",
    "lint:fix": "eslint games --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test \"games/test/**/*.test.mjs\""
  },
  "dependencies": {
    "@haiyue/engine-gamepad": "file:vendor/haiyue-engine-0.2.1.tgz",
    "@haiyue/animation-spec": "file:vendor/haiyue-animation-spec-0.2.1.tgz",
    "@haiyue/engine": "file:vendor/haiyue-engine-0.2.1.tgz",
    "@haiyue/extensions": "file:vendor/haiyue-extensions-0.2.1.tgz",
    "@haiyue/ui": "file:vendor/haiyue-ui-0.2.2.tgz",
    "wgpu-matrix": "^3.0.0",
    "@haiyue/extensions-controls": "file:vendor/haiyue-extensions-0.2.1.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/pluginutils": "^5.4.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@webgpu/types": "^0.1.40",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "magic-string": "^0.30.21",
    "rollup": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.2.0",
    "typescript-eslint": "^8.68.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.60.4"
  }
}
